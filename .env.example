# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=trojan-dev-verify-token
WHATSAPP_APP_SECRET=

# --- Google Gemini (LLM, via the OpenAI-compatible endpoint) ---
# Get a free key at https://aistudio.google.com — no payment required for the free tier.
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current model lineup.
GEMINI_MODEL=gemini-3.1-flash-lite
# Used only for generating voice replies to incoming voice notes — free tier as of writing.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Postgres ---
DATABASE_URL=postgres://trojan:trojan@localhost:5432/trojan_whatsapp

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Sales handoff ---
# Single test number leads are forwarded to for now (E.164, no +), e.g. 97400000000
SALES_TEST_NUMBER=

# --- Business hours (Qatar time) ---
BUSINESS_TIMEZONE=Asia/Qatar
BUSINESS_DAYS=0,1,2,3,4
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00

# --- Debounce ---
DEBOUNCE_QUIET_MS=8000
DEBOUNCE_MAX_WAIT_MS=25000

PORT=3000
